# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for Prisma.
# Local dev example (after `docker run --name vidya-yati-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16`):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vidya_yati?schema=public"

# NextAuth — generate a secret with `openssl rand -base64 32`
AUTH_SECRET=""

# Required in any deployed environment (not just local dev), despite
# `trustHost: true` in auth.config.ts. Discovered via a live Railway
# deploy: without this set, Auth.js still boots and serves requests, but
# silently mis-detects its own canonical origin as the container's
# internal address (e.g. http://localhost:8080) instead of the public
# domain — which manifested as a real, reproducible GET /signin
# self-redirect in production (a NEXT_REDIRECT back to /signin itself),
# not a caching issue. Set to the exact public URL the app is served at.
AUTH_URL="https://your-deployed-domain.example.com"

# Left for when payments/WhatsApp integration comes off hold (see CLAUDE.md
# "On hold" section) — not needed for the initial build.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# WHATSAPP_API_TOKEN=""
