# Copy this file to `.env` for local dev, or set these as environment
# variables directly in your hosting provider (e.g. Railway's Variables
# tab) for a deployed environment. Never commit real values — `.env` is
# gitignored for exactly this reason.

# PostgreSQL connection string. Locally this points at the embedded dev
# Postgres started by `npm run db:local`. On Railway, add the Postgres
# plugin to your project and reference its connection string here (Railway
# can wire this up automatically as a variable reference).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth's session-signing secret. MUST be a real random value in any
# deployed environment — generate one with:
#   openssl rand -base64 32
# Do not reuse the local dev value, and never commit the real value.
AUTH_SECRET="replace-with-a-real-random-secret"

# Set automatically by most hosts (including Railway) — only needed here
# if your platform doesn't set it, or for local testing of production
# behavior. Controls the startup guard in lib/env-check.ts that refuses to
# boot with a placeholder AUTH_SECRET once this is "production".
# NODE_ENV="production"
